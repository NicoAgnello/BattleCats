{
  "name": "topdown-battle-royale-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "test:rooms": "node loadtest/rooms-test.mjs",
    "test:mechanics": "node loadtest/mechanics-test.mjs",
    "loadtest": "node loadtest/loadtest.mjs --clients 20 --duration 30"
  }
}
